{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "hooks/session-state-inject.sh" },
      { "command": "hooks/dispatch-gate-session-init.sh" }
    ],
    "beforeSubmitPrompt": [
      { "command": "hooks/session-state-digest.sh" }
    ],
    "preCompact": [
      { "command": "hooks/session-state-checkpoint.sh" }
    ],
    "beforeShellExecution": [
      { "command": "hooks/block-bad-bash.sh" },
      { "command": "hooks/survey-before-act.sh" }
    ],
    "preToolUse": [
      { "command": "hooks/dispatch-gate-pre-tool.sh", "failClosed": true }
    ],
    "postToolUse": [
      { "command": "hooks/dispatch-gate-post-tool.sh" }
    ],
    "beforeReadFile": [
      { "command": "hooks/dispatch-gate-before-read.sh", "failClosed": true }
    ],
    "afterFileEdit": [
      { "command": "hooks/dispatch-gate-after-file-edit.sh" }
    ],
    "subagentStop": [
      { "command": "hooks/dispatch-gate-subagent-stop.sh" }
    ],
    "stop": [
      { "command": "hooks/dispatch-gate-stop.sh", "loop_limit": 8, "timeout": 120 }
    ]
  }
}
