{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash $HOME/.claude/hooks/block-bad-bash.sh" },
          { "type": "command", "command": "bash $HOME/.claude/hooks/survey-before-act.sh" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "bash $HOME/.claude/hooks/block-general-purpose.sh", "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash $HOME/.claude/hooks/post-edit-scan.sh", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/session-state-inject.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/session-state-digest.sh" } ] }
    ],
    "PreCompact": [
      { "matcher": "auto",   "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/session-state-checkpoint.sh" } ] },
      { "matcher": "manual", "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/session-state-checkpoint.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/review-gate-stop.sh" } ] }
    ],
    "SubagentStop": [
      { "matcher": "code-reviewer|security-reviewer|library-reviewer|data-model-verifier",
        "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/review-verdict-capture.sh" } ] }
    ]
  }
}
