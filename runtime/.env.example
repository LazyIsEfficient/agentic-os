# v2 runtime config template — copy to .env via `bash setup.sh` (the real .env is gitignored).
# Consumed by the Rust orchestrator and auto-loaded by docker compose for REDIS_PORT.

# Redis host the orchestrator connects to (compose publishes on the host loopback).
REDIS_HOST=127.0.0.1
# Host port mapped to the container's 6379; also the compose published port.
REDIS_PORT=6379
# Redis logical DB index for the blackboard.
REDIS_DB=0

# Blackboard key prefix — keys are {BB_PREFIX}:{run}:state|artifact|log|votes:{round}.
BB_PREFIX=bb
# Max collaboration rounds before the run is force-terminated (round cap).
BB_MAX_ROUNDS=6
# Per-participant retry budget when a `claude -p` turn fails/empties/parse-errors.
BB_MAX_RETRIES=2
# Timeout (seconds) for a single `claude -p` turn; on expiry the child is killed
# and the turn re-dispatched per BB_MAX_RETRIES.
BB_TURN_TIMEOUT_SECS=120
