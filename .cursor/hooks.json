{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-state-inject.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/session-state-digest.sh"
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/session-state-checkpoint.sh"
      }
    ],
    "beforeShellExecution": [
      { "command": ".cursor/hooks/block-bad-bash.sh" },
      { "command": ".cursor/hooks/survey-before-act.sh" }
    ]
  }
}
