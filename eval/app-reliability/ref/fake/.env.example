# RabbitMQ stream connection (defaults shown). The harness provides the broker.
RABBITMQ_STREAM_HOST=localhost
RABBITMQ_STREAM_PORT=5552
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_STREAM_NAME=notes

# Optional: on-disk persistence directory (worker writes, API reads).
# NOTES_DATA_DIR=./data
