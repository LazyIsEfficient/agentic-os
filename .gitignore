# Local / machine-specific
.DS_Store
Thumbs.db

# Claude Code — local overrides (do not commit)
.claude/settings.local.json

# Claude Code — persistent memory (machine-local, contains personal context).
# Gitignored so it never ships; validate.sh still scans it when present locally —
# dangling wikilinks in .claude/memory/*.md fail local validate but not CI.
.claude/memory/

# AgenticOS — live session-state doc (per-session working state; the committed
# schema is SESSION-STATE.template.md). Created from the template by
# scripts/session-state.sh init.
SESSION-STATE.md
.claude/session-state.checkpoints
.claude/survey-guard.warns

# setup-guard live manifest (per-project setup contract; injected into context ->
# SECURITY.md rule-7 untrusted/user-local data, never committed to a shared
# checkout). The committed schema is .claude/setup-guard.manifest.example.
.claude/setup-guard.manifest

# Claude Code — agent worktrees (ephemeral, machine-local)
.claude/worktrees/

# Claude Code — review findings ledger (Tier 2 advisory noise; machine-local by
# default). Team-shared mode: delete this ignore line and commit
# .claude/ledger/findings.jsonl so recurrence is measured across the team.
.claude/ledger/

# Editor
*.swp
*.swo
*~

# Environment and secrets (if ever added)
.env
.env.*
!.env.example

# Optional tooling
.tmp/
node_modules/
__pycache__/

pocs/

# Release artifacts built by scripts/release.sh (not source)
/agentic-os-*.tar.gz

eval/metrics/runs/