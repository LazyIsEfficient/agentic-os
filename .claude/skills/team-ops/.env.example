# AI Team Ops - Environment Variables
# Set at least one LLM provider key for the Elon Algorithm qualitative analysis.
# Quantitative scoring and stack ranking run without any key (or use --dry-run).

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Model override (defaults: claude-sonnet-4-5 for anthropic, gpt-4o for openai)
# LLM_MODEL=claude-sonnet-4-5

# Required for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required for LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
