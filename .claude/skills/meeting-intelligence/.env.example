# Meeting Intelligence - Environment Variables
# Set at least one LLM provider key. HubSpot is only needed for --push-hubspot.

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Model override (defaults: claude-sonnet-4-5 for anthropic, gpt-4o for openai)
# LLM_MODEL=claude-sonnet-4-5

# Required for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Required for LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional: HubSpot private-app token, only used with --push-hubspot
# HUBSPOT_API_KEY=pat-...
